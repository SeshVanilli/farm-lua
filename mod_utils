--  mod_utils.lua  –  ShoxFarm módulo compartilhado
--  Upado no Pastebin como RAW e carregado pelo loader via loadstring()
--  ctx recebido: tabela vazia (apenas para consistência)
-- ===================================================================

local M = {}

local ffi      = require 'ffi'
local imgui    = require 'imgui'

pcall(ffi.cdef, [[
    void keybd_event(uint8_t bVk, uint8_t bScan, uint32_t dwFlags, uintptr_t dwExtraInfo);
]])
M.user32 = ffi.load("user32")

M.VK_Y            = 0x59
M.VK_N            = 0x4E
M.VK_F            = 0x46
M.VK_RETURN       = 0x0D
M.VK_ESCAPE       = 0x1B
M.VK_F10          = 0x79
M.KEYEVENTF_KEYUP = 0x0002

function M.log(tag, msg, cor)
    cor = cor or 0x00FFAA
    sampAddChatMessage('[' .. tag .. '] ' .. msg, cor)
end

function M.strip(s)
    return (tostring(s or ''):gsub('{%x%x%x%x%x%x}', ''))
end

function M.trim(s)
    return (s or ''):match('^%s*(.-)%s*$')
end

function M.jitter(base, range)
    if range <= 0 then return base end
    return base + math.random(0, range)
end

-- ===================================================================
--  TRAVA GLOBAL DE TECLADO (compartilhada entre TODOS os módulos)
--  Impede que 2 módulos (ou 2 threads) chamem keybd_event/
--  setVirtualKeyDown ao mesmo tempo. Isso é suspeito real de crash
--  nativo: o SA-MP recicla o mesmo ID de dialog (32700) pra tudo, e
--  2 teclas sintéticas simultâneas enquanto um dialog está abrindo/
--  fechando pode corromper o estado interno do client e derrubar o
--  processo sem gerar nenhum erro de Lua (por isso não aparece nada
--  no moonloader.log antes do crash).
-- ===================================================================
local travaTeclado = false

function M.comTravaTeclado(fn)
    local esperas = 0
    while travaTeclado do
        wait(50)
        esperas = esperas + 1
        if esperas > 100 then break end -- ~5s, nao trava pra sempre por seguranca
    end
    travaTeclado = true
    local ok, err = pcall(fn)
    travaTeclado = false
    if not ok then
        print('[ShoxFarm][ERRO tecla] ' .. tostring(err))
    end
end

function M.pressKey(vk)
    M.comTravaTeclado(function()
        M.user32.keybd_event(vk, 0, 0, 0)
        wait(60)
        M.user32.keybd_event(vk, 0, M.KEYEVENTF_KEYUP, 0)
    end)
end

function M.pressKeyN()
    M.comTravaTeclado(function()
        if setVirtualKeyDown then
            setVirtualKeyDown(M.VK_N, true); wait(60); setVirtualKeyDown(M.VK_N, false)
        else
            M.user32.keybd_event(M.VK_N, 0, 0, 0); wait(60)
            M.user32.keybd_event(M.VK_N, 0, M.KEYEVENTF_KEYUP, 0)
        end
    end)
end

function M.pressKeyEsc()
    M.comTravaTeclado(function()
        if setVirtualKeyDown then
            setVirtualKeyDown(M.VK_ESCAPE, true); wait(60); setVirtualKeyDown(M.VK_ESCAPE, false)
        else
            M.user32.keybd_event(M.VK_ESCAPE, 0, 0, 0); wait(60)
            M.user32.keybd_event(M.VK_ESCAPE, 0, M.KEYEVENTF_KEYUP, 0)
        end
    end)
end

function M.colorBtn(label, w, h, r,g,b, rh,gh,bh)
    imgui.PushStyleColor(imgui.Col.Button,        imgui.ImVec4(r,  g,  b,  1))
    imgui.PushStyleColor(imgui.Col.ButtonHovered, imgui.ImVec4(rh, gh, bh, 1))
    imgui.PushStyleColor(imgui.Col.ButtonActive,  imgui.ImVec4(r,  g,  b,  0.8))
    local clicked = imgui.Button(label, imgui.ImVec2(w, h))
    imgui.PopStyleColor(3)
    return clicked
end

function M.warnText(txt)
    imgui.PushStyleColor(imgui.Col.Text, imgui.ImVec4(1.0, 0.85, 0.1, 1))
    imgui.SetCursorPosX(20)
    imgui.Text(txt)
    imgui.PopStyleColor()
end

return M
