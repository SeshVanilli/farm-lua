--[[
    mod_auto.lua  –  Auto's
    Módulo do ShoxFarm:
      • Auto Caixinha → /caixinha a cada 30 min + gatilho "Juros Bancario"
      • Auto Drogas   → 1 checkbox + seletor de droga
                        Monitora colete: só para quando atingir 200.
                        Bloqueia animações do servidor durante todo o uso.
      • Auto Proteção → detecta veículo ou interior, envia /protecao,
                        clica no botão 0 do dialog e aguarda 5 min para repetir.
      • Auto Kit Sócio → /kitsocio 1 e /kitsocio 2 separados,
                         envia apenas quando sem colete E HP < 101.
]]

local sampev = require 'lib.samp.events'
local imgui  = require 'imgui'

return function(ctx)
    local U = ctx.U

    -- ===================================================================
    --  PROTEÇÃO RPC — bloqueia animações enquanto droga estiver ativa
    -- ===================================================================
    local block_anims = false

    function sampev.onApplyPlayerAnimation(playerId, ...)
        if block_anims and playerId == select(2, sampGetPlayerIdByCharHandle(playerPed)) then
            return false
        end
    end

    -- ===================================================================
    --  AUTO CAIXINHA
    -- ===================================================================
    local cxAtivo     = false
    local CAIXINHA_MS = 30 * 60 * 1000
    local chkCaixinha = imgui.ImBool(false)

    local function enviarCaixinha()
        if isSampAvailable() then
            sampSendChat("/caixinha")
            sampAddChatMessage('[ShoxFarm] Auto Caixinha: /caixinha enviado!', 0x00CFFF)
        end
    end

    local function caixinhaLigar()
        if cxAtivo then return end
        cxAtivo = true
        chkCaixinha.v = true
        enviarCaixinha()
        lua_thread.create(function()
            while cxAtivo do
                wait(CAIXINHA_MS)
                if cxAtivo and isSampAvailable() then enviarCaixinha() end
            end
        end)
        sampAddChatMessage('[ShoxFarm] Auto Caixinha ATIVADO', 0x00FF88)
    end

    local function caixinhaDesligar()
        if not cxAtivo then return end
        cxAtivo = false
        chkCaixinha.v = false
        sampAddChatMessage('[ShoxFarm] Auto Caixinha DESATIVADO', 0xFF6666)
    end

    -- ===================================================================
    --  AUTO DROGAS
    -- ===================================================================
    local DROGAS = {
        { nome = "LSD",     cmd = "/usarlsd"     },
        { nome = "Crack",   cmd = "/usarcrack"   },
        { nome = "Cocaina", cmd = "/usarcocaina" },
        { nome = "Maconha", cmd = "/usarmaconha" },
    }

    local drogaSelIdx  = 1
    local drogaSelImm  = imgui.ImInt(0)
    local drogaAtiva   = false
    local chkDroga     = imgui.ImBool(false)
    local ARMOUR_ALVO  = 200
    local CICLO_MS     = 15000

    local comboBuf = ""
    for _, d in ipairs(DROGAS) do
        comboBuf = comboBuf .. d.nome .. "\0"
    end
    comboBuf = comboBuf .. "\0"

    local function getArmour()
        local ok, armour = pcall(getCharArmour, playerPed)
        return ok and armour or 0
    end

    local function getHP()
        local ok, hp = pcall(getCharHealth, playerPed)
        return ok and hp or 100
    end

    local function drogaLigar()
        if drogaAtiva then return end
        drogaAtiva  = true
        chkDroga.v  = true
        block_anims = true

        local nome = DROGAS[drogaSelIdx].nome
        sampAddChatMessage('[ShoxFarm] Auto ' .. nome .. ' ATIVADO', 0x00FF88)

        lua_thread.create(function()
            while drogaAtiva do
                local cmd = DROGAS[drogaSelIdx].cmd
                if getArmour() < ARMOUR_ALVO then
                    sampSendChat(cmd)
                    sampAddChatMessage('[ShoxFarm] ' .. cmd .. ' enviado!', 0xFFAA00)
                    wait(CICLO_MS)
                else
                    wait(1000)
                end
            end
            block_anims = false
        end)
    end

    local function drogaDesligar()
        if not drogaAtiva then return end
        drogaAtiva = false
        chkDroga.v = false
        sampAddChatMessage('[ShoxFarm] Auto ' .. DROGAS[drogaSelIdx].nome .. ' DESATIVADO', 0xFF6666)
    end

    -- ===================================================================
    --  AUTO PROTEÇÃO
    -- ===================================================================
    local protAtivo      = false
    local chkProt        = imgui.ImBool(false)
    local PROT_COOLDOWN  = 5 * 60 * 1000
    local PROT_DIALOG_TO = 8000

    local protDialogRecebido = false
    local protAguardandoCD   = false
    local protCDRestante     = 0
    local protCDTotal        = PROT_COOLDOWN

    local function estaEmVeiculoOuInterior()
        local emVeiculo = isCharInAnyCar(playerPed)
        local interior  = getActiveInterior() ~= 0
        return emVeiculo or interior
    end

    local function protLigar()
        if protAtivo then return end
        protAtivo = true
        chkProt.v = true
        sampAddChatMessage('[ShoxFarm] Auto Protecao ATIVADO', 0x00FF88)

        lua_thread.create(function()
            while protAtivo do
                while protAtivo and not estaEmVeiculoOuInterior() do
                    wait(1000)
                end
                if not protAtivo then break end

                sampSendChat("/protecao")
                sampAddChatMessage('[ShoxFarm] /protecao enviado!', 0xFFAA00)

                protDialogRecebido = false
                local elapsed = 0
                while protAtivo and not protDialogRecebido and elapsed < PROT_DIALOG_TO do
                    wait(200)
                    elapsed = elapsed + 200
                end

                if protDialogRecebido then
                    sampAddChatMessage('[ShoxFarm] Protecao confirmada! Aguardando 5 min...', 0x00FF88)
                    protAguardandoCD = true
                    protCDRestante   = PROT_COOLDOWN
                    local tick = 0
                    while protAtivo and tick < PROT_COOLDOWN do
                        wait(1000)
                        tick           = tick + 1000
                        protCDRestante = PROT_COOLDOWN - tick
                    end
                    protAguardandoCD = false
                    protCDRestante   = 0
                else
                    sampAddChatMessage('[ShoxFarm] Dialog nao detectado, tentando novamente em 10s...', 0xFF6666)
                    wait(10000)
                end
            end
        end)
    end

    local function protDesligar()
        if not protAtivo then return end
        protAtivo        = false
        chkProt.v        = false
        protAguardandoCD = false
        protCDRestante   = 0
        sampAddChatMessage('[ShoxFarm] Auto Protecao DESATIVADO', 0xFF6666)
    end

    -- ===================================================================
    --  AUTO KIT SÓCIO
    -- ===================================================================
    local KITS = {
        { nome = "Kit Socio 1", cmd = "/kitsocio 1" },
        { nome = "Kit Socio 2", cmd = "/kitsocio 2" },
    }

    local kitAtivo  = { false, false }
    local chkKit    = { imgui.ImBool(false), imgui.ImBool(false) }
    local KIT_CICLO  = 3000
    local KIT_HP_MIN  = 101
    local KIT_ARM_MIN = 1

    local function kitLigar(i)
        if kitAtivo[i] then return end
        kitAtivo[i]  = true
        chkKit[i].v  = true
        sampAddChatMessage('[ShoxFarm] Auto ' .. KITS[i].nome .. ' ATIVADO', 0x00FF88)

        lua_thread.create(function()
            while kitAtivo[i] do
                if getArmour() < KIT_ARM_MIN and getHP() < KIT_HP_MIN then
                    sampSendChat(KITS[i].cmd)
                    sampAddChatMessage('[ShoxFarm] ' .. KITS[i].cmd .. ' enviado!', 0xFFAA00)
                end
                wait(KIT_CICLO)
            end
        end)
    end

    local function kitDesligar(i)
        if not kitAtivo[i] then return end
        kitAtivo[i]  = false
        chkKit[i].v  = false
        sampAddChatMessage('[ShoxFarm] Auto ' .. KITS[i].nome .. ' DESATIVADO', 0xFF6666)
    end

    -- ===================================================================
    --  EVENTO: mensagem do servidor
    -- ===================================================================
    local function onServerMessage(color, text)
        if cxAtivo then
            local limpo = text:gsub('{%x%x%x%x%x%x}', '')
            if limpo:lower():find('juros bancario') then
                lua_thread.create(function()
                    wait(300)
                    enviarCaixinha()
                end)
            end
        end
    end

    -- ===================================================================
    --  EVENTO: dialog do servidor → roteado pelo loader
    -- ===================================================================
    local function onShowDialog(dialogId, style, tituloLimpo, textoDialog, conteudo)
        if not protAtivo then return false end

        if tituloLimpo:lower():find('protecao', 1, true) then
            sampAddChatMessage('[ShoxFarm] Dialog protecao detectado! Fechando...', 0x00FF88)
            lua_thread.create(function()
                wait(150)
                sampSendDialogResponse(dialogId, 0, -1, "")
                protDialogRecebido = true
            end)
        end

        return false
    end

    -- ===================================================================
    --  GUI — helpers de estilo
    -- ===================================================================
    local function pushChk()
        imgui.PushStyleColor(imgui.Col.CheckMark,      imgui.ImVec4(0.85, 0.10, 0.10, 1.00))
        imgui.PushStyleColor(imgui.Col.FrameBg,        imgui.ImVec4(0.15, 0.10, 0.10, 1.00))
        imgui.PushStyleColor(imgui.Col.FrameBgHovered, imgui.ImVec4(0.25, 0.08, 0.08, 1.00))
        imgui.PushStyleColor(imgui.Col.FrameBgActive,  imgui.ImVec4(0.40, 0.06, 0.06, 1.00))
    end
    local function popChk() imgui.PopStyleColor(4) end

    local function pushCombo()
        imgui.PushStyleColor(imgui.Col.FrameBg,        imgui.ImVec4(0.15, 0.08, 0.08, 1.00))
        imgui.PushStyleColor(imgui.Col.FrameBgHovered, imgui.ImVec4(0.25, 0.06, 0.06, 1.00))
        imgui.PushStyleColor(imgui.Col.FrameBgActive,  imgui.ImVec4(0.35, 0.05, 0.05, 1.00))
        imgui.PushStyleColor(imgui.Col.Button,         imgui.ImVec4(0.55, 0.05, 0.05, 1.00))
        imgui.PushStyleColor(imgui.Col.ButtonHovered,  imgui.ImVec4(0.70, 0.08, 0.08, 1.00))
        imgui.PushStyleColor(imgui.Col.Header,         imgui.ImVec4(0.55, 0.05, 0.05, 1.00))
        imgui.PushStyleColor(imgui.Col.HeaderHovered,  imgui.ImVec4(0.70, 0.08, 0.08, 1.00))
        imgui.PushStyleColor(imgui.Col.HeaderActive,   imgui.ImVec4(0.85, 0.10, 0.10, 1.00))
        imgui.PushStyleColor(imgui.Col.PopupBg,        imgui.ImVec4(0.08, 0.04, 0.04, 0.97))
    end
    local function popCombo() imgui.PopStyleColor(9) end

    local function statusTag(on)
        if on then
            imgui.PushStyleColor(imgui.Col.Text, imgui.ImVec4(0.00, 1.00, 0.55, 1.00))
            imgui.Text("[ON]")
        else
            imgui.PushStyleColor(imgui.Col.Text, imgui.ImVec4(0.55, 0.55, 0.55, 1.00))
            imgui.Text("[OFF]")
        end
        imgui.PopStyleColor()
    end

    -- ===================================================================
    --  GUI — draw
    -- ===================================================================
    local function drawGui(W)
        imgui.Dummy(imgui.ImVec2(0, 6))

        local titulo = "  Auto's"
        imgui.SetCursorPosX((W - imgui.CalcTextSize(titulo).x) * 0.5)
        imgui.PushStyleColor(imgui.Col.Text, imgui.ImVec4(0.00, 0.80, 1.00, 1.00))
        imgui.Text(titulo)
        imgui.PopStyleColor()

        imgui.SetCursorPosX(20)
        imgui.Text("------------------------------------------------")
        imgui.Dummy(imgui.ImVec2(0, 4))

        -- ── Caixinha ─────────────────────────────────────────────
        imgui.SetCursorPosX(20)
        imgui.PushStyleColor(imgui.Col.Text, imgui.ImVec4(0.80, 0.80, 0.20, 1.00))
        imgui.Text("[ Caixinha ]")
        imgui.PopStyleColor()
        imgui.Dummy(imgui.ImVec2(0, 3))

        pushChk()
        imgui.SetCursorPosX(20)
        if imgui.Checkbox("|   |Auto caixinha", chkCaixinha) then
            if chkCaixinha.v then caixinhaLigar() else caixinhaDesligar() end
        end
        popChk()
        imgui.SameLine()
        imgui.SetCursorPosX(W - 80)
        statusTag(cxAtivo)

        imgui.Dummy(imgui.ImVec2(0, 3))
        imgui.SetCursorPosX(20)
        imgui.PushStyleColor(imgui.Col.Text, imgui.ImVec4(0.55, 0.55, 0.55, 1.00))
        imgui.Text("Timer: 30min  |  Gatilho: Juros Bancario")
        imgui.PopStyleColor()

        imgui.Dummy(imgui.ImVec2(0, 8))
        imgui.SetCursorPosX(20)
        imgui.Text("------------------------------------------------")
        imgui.Dummy(imgui.ImVec2(0, 4))

        -- ── Drogas ───────────────────────────────────────────────
        imgui.SetCursorPosX(20)
        imgui.PushStyleColor(imgui.Col.Text, imgui.ImVec4(0.80, 0.80, 0.20, 1.00))
        imgui.Text("[ Drogas — para quando colete = 200 ]")
        imgui.PopStyleColor()
        imgui.Dummy(imgui.ImVec2(0, 6))

        pushCombo()
        imgui.SetCursorPosX(20)
        imgui.PushItemWidth(W - 40)
        if imgui.Combo("##drogasel", drogaSelImm, comboBuf) then
            drogaSelIdx = drogaSelImm.v + 1
            if drogaAtiva then
                drogaDesligar()
                lua_thread.create(function()
                    wait(100)
                    drogaLigar()
                end)
            end
        end
        imgui.PopItemWidth()
        popCombo()

        imgui.Dummy(imgui.ImVec2(0, 6))

        pushChk()
        imgui.SetCursorPosX(20)
        if imgui.Checkbox("|   |Auto Droga", chkDroga) then
            if chkDroga.v then drogaLigar() else drogaDesligar() end
        end
        popChk()
        imgui.SameLine()
        imgui.SetCursorPosX(W - 80)
        statusTag(drogaAtiva)

        imgui.Dummy(imgui.ImVec2(0, 8))
        imgui.SetCursorPosX(20)
        imgui.PushStyleColor(imgui.Col.Text, imgui.ImVec4(0.50, 0.50, 0.50, 1.00))
        imgui.TextWrapped("Animacoes bloqueadas do momento da ativacao ate desativar.")
        imgui.PopStyleColor()

        imgui.Dummy(imgui.ImVec2(0, 4))
        imgui.SetCursorPosX(20)
        local armourAtual = getArmour()
        local corA = (armourAtual >= ARMOUR_ALVO)
            and imgui.ImVec4(0.00, 1.00, 0.55, 1.00)
            or  imgui.ImVec4(1.00, 0.55, 0.00, 1.00)
        imgui.PushStyleColor(imgui.Col.Text, corA)
        imgui.Text(string.format("Colete atual: %.0f / %d", armourAtual, ARMOUR_ALVO))
        imgui.PopStyleColor()

        imgui.Dummy(imgui.ImVec2(0, 8))
        imgui.SetCursorPosX(20)
        imgui.Text("------------------------------------------------")
        imgui.Dummy(imgui.ImVec2(0, 4))

        -- ── Proteção ─────────────────────────────────────────────
        imgui.SetCursorPosX(20)
        imgui.PushStyleColor(imgui.Col.Text, imgui.ImVec4(0.80, 0.80, 0.20, 1.00))
        imgui.Text("[ Protecao — veiculo ou interior ]")
        imgui.PopStyleColor()
        imgui.Dummy(imgui.ImVec2(0, 6))

        pushChk()
        imgui.SetCursorPosX(20)
        if imgui.Checkbox("|   |Auto Protecao", chkProt) then
            if chkProt.v then protLigar() else protDesligar() end
        end
        popChk()
        imgui.SameLine()
        imgui.SetCursorPosX(W - 80)
        statusTag(protAtivo)

        imgui.Dummy(imgui.ImVec2(0, 4))
        imgui.SetCursorPosX(20)
        imgui.PushStyleColor(imgui.Col.Text, imgui.ImVec4(0.55, 0.55, 0.55, 1.00))
        imgui.Text("Cooldown: 5 min  |  Clica Fechar automaticamente")
        imgui.PopStyleColor()

        if protAtivo and protAguardandoCD then
            imgui.Dummy(imgui.ImVec2(0, 4))
            imgui.SetCursorPosX(20)
            local progresso = 1.0 - (protCDRestante / protCDTotal)
            imgui.PushStyleColor(imgui.Col.PlotHistogram, imgui.ImVec4(0.00, 0.75, 0.40, 1.00))
            imgui.PushStyleColor(imgui.Col.FrameBg,       imgui.ImVec4(0.12, 0.12, 0.12, 1.00))
            imgui.PushItemWidth(W - 40)
            imgui.ProgressBar(progresso, imgui.ImVec2(W - 40, 14), "")
            imgui.PopItemWidth()
            imgui.PopStyleColor(2)

            imgui.SetCursorPosX(20)
            local secsLeft = math.ceil(protCDRestante / 1000)
            local mm = math.floor(secsLeft / 60)
            local ss = secsLeft % 60
            imgui.PushStyleColor(imgui.Col.Text, imgui.ImVec4(0.65, 0.65, 0.65, 1.00))
            imgui.Text(string.format("Proximo em: %02d:%02d", mm, ss))
            imgui.PopStyleColor()
        elseif protAtivo then
            imgui.Dummy(imgui.ImVec2(0, 4))
            imgui.SetCursorPosX(20)
            imgui.PushStyleColor(imgui.Col.Text, imgui.ImVec4(1.00, 0.80, 0.00, 1.00))
            imgui.Text("Aguardando veiculo ou interior...")
            imgui.PopStyleColor()
        end

        imgui.Dummy(imgui.ImVec2(0, 8))
        imgui.SetCursorPosX(20)
        imgui.Text("------------------------------------------------")
        imgui.Dummy(imgui.ImVec2(0, 4))

        -- ── Kit Sócio ────────────────────────────────────────────
        imgui.SetCursorPosX(20)
        imgui.PushStyleColor(imgui.Col.Text, imgui.ImVec4(0.80, 0.80, 0.20, 1.00))
        imgui.Text("[ Kit Socio — sem colete e HP < 101 ]")
        imgui.PopStyleColor()
        imgui.Dummy(imgui.ImVec2(0, 6))

        for i = 1, 2 do
            pushChk()
            imgui.SetCursorPosX(20)
            if imgui.Checkbox("|   |Auto /kitsocio " .. i, chkKit[i]) then
                if chkKit[i].v then kitLigar(i) else kitDesligar(i) end
            end
            popChk()
            imgui.SameLine()
            imgui.SetCursorPosX(W - 80)
            statusTag(kitAtivo[i])
            if i == 1 then imgui.Dummy(imgui.ImVec2(0, 4)) end
        end

        imgui.Dummy(imgui.ImVec2(0, 4))
        imgui.SetCursorPosX(20)
        local hpAtual  = getHP()
        local armKit   = getArmour()
        local corKit   = (armKit < KIT_ARM_MIN and hpAtual < KIT_HP_MIN)
            and imgui.ImVec4(1.00, 0.30, 0.00, 1.00)
            or  imgui.ImVec4(0.00, 1.00, 0.55, 1.00)
        imgui.PushStyleColor(imgui.Col.Text, corKit)
        imgui.Text(string.format("HP: %.0f  |  Colete: %.0f", hpAtual, armKit))
        imgui.PopStyleColor()

        imgui.Dummy(imgui.ImVec2(0, 6))
    end

    -- ===================================================================
    --  INTERFACE PÚBLICA
    -- ===================================================================
    return {
        drawGui         = drawGui,
        onServerMessage = onServerMessage,
        onShowDialog    = onShowDialog,
        isAtivo         = function()
            return cxAtivo or drogaAtiva or protAtivo or kitAtivo[1] or kitAtivo[2]
        end,

        -- salvar / carregar estado
        getEstado = function()
            return {
                caixinha  = cxAtivo,
                droga     = drogaAtiva,
                drogaIdx  = drogaSelIdx,
                protecao  = protAtivo,
                kit1      = kitAtivo[1],
                kit2      = kitAtivo[2],
            }
        end,
        carregarEstado = function(s)
            -- sincroniza checkboxes
            chkCaixinha.v  = s.caixinha
            chkDroga.v     = s.droga
            chkProt.v      = s.protecao
            chkKit[1].v    = s.kit1
            chkKit[2].v    = s.kit2
            -- sincroniza combo de droga
            drogaSelIdx    = s.drogaIdx
            drogaSelImm.v  = s.drogaIdx - 1
            -- religa os que estavam ativos
            if s.caixinha then caixinhaLigar() end
            if s.droga    then drogaLigar()    end
            if s.protecao then protLigar()     end
            if s.kit1     then kitLigar(1)     end
            if s.kit2     then kitLigar(2)     end
        end,
    }
end
