--[[
    mod_auto.lua  –  Auto's
    Módulo do ShoxFarm:
      • Auto Caixinha  → /caixinha a cada 30 min + gatilho "Juros Bancario"
      • Auto Drogas    → /usarlsd | /usarcrack | /usarcocaina | /usarmaconha
                         Monitora colete do player: só para quando atingir 200.
                         Antes de cada comando, ativa proteções de RPC temporárias
                         (nobebado, noespecialactionsv, nofreezecharsv,
                          nocleananimsv, noanim, bloacksincweapon)
                         e as desativa logo após o envio.
]]

local sampev = require 'lib.samp.events'
local imgui  = require 'imgui'

return function(ctx)
    local U = ctx.U

    -- ===================================================================
    --  PROTEÇÕES RPC  (flags booleanas simples, SEM ImBool — só internas)
    --  Cada flag = true significa "bloquear este RPC agora"
    -- ===================================================================
    local rpc = {
        nobebado           = false,
        noespecialactionsv = false,
        nofreezecharsv     = false,
        nocleananimsv      = false,
        noanim             = false,
        bloacksincweapon   = false,
    }

    -- Ativa todas as proteções de uso de droga
    local function rpcLigar()
        rpc.nobebado           = true
        rpc.noespecialactionsv = true
        rpc.nofreezecharsv     = true
        rpc.nocleananimsv      = true
        rpc.noanim             = true
        rpc.bloacksincweapon   = true
    end

    -- Desativa todas as proteções de uso de droga
    local function rpcDesligar()
        rpc.nobebado           = false
        rpc.noespecialactionsv = false
        rpc.nofreezecharsv     = false
        rpc.nocleananimsv      = false
        rpc.noanim             = false
        rpc.bloacksincweapon   = false
    end

    -- Helper: pega o myId uma vez
    local function getMyId()
        local ok, id = sampGetPlayerIdByCharHandle(playerPed)
        if ok then return id end
        return -1
    end

    -- ===================================================================
    --  INTERCEPTADORES RPC  (registrados via sampev, sempre ativos,
    --  mas só bloqueiam quando as flags estiverem true)
    -- ===================================================================

    -- Bloquear efeito de embriaguez
    local _origDrunk = sampev.onSetPlayerDrunk
    sampev.onSetPlayerDrunk = function(level)
        if rpc.nobebado then return false end
        if _origDrunk then return _origDrunk(level) end
    end

    -- Bloquear ações especiais
    local _origSpecial = sampev.onSetPlayerSpecialAction
    sampev.onSetPlayerSpecialAction = function(action)
        if rpc.noespecialactionsv then return false end
        if _origSpecial then return _origSpecial(action) end
    end

    -- Bloquear congelamento
    local _origFreeze = sampev.onTogglePlayerControllable
    sampev.onTogglePlayerControllable = function(controlled)
        if rpc.nofreezecharsv then return false end
        if _origFreeze then return _origFreeze(controlled) end
    end

    -- Bloquear limpeza de animação
    local _origClearAnim = sampev.onClearPlayerAnimation
    sampev.onClearPlayerAnimation = function(playerId)
        if rpc.nocleananimsv and playerId == getMyId() then return false end
        if _origClearAnim then return _origClearAnim(playerId) end
    end

    -- Bloquear animações do servidor
    local _origAnim = sampev.onApplyPlayerAnimation
    sampev.onApplyPlayerAnimation = function(playerId, animLib, animName, ...)
        if rpc.noanim and playerId == getMyId() then return false end
        if _origAnim then return _origAnim(playerId, animLib, animName, ...) end
    end

    -- Bypass sincronização de armas (pacote 204)
    local _origPkt = sampev.onSendPacket
    sampev.onSendPacket = function(packetId, ...)
        if rpc.bloacksincweapon and packetId == 204 then return false end
        if _origPkt then return _origPkt(packetId, ...) end
    end

    -- ===================================================================
    --  AUTO CAIXINHA
    -- ===================================================================
    local cxAtivo        = false
    local CAIXINHA_MS    = 30 * 60 * 1000
    local chkCaixinha    = imgui.ImBool(false)

    local function enviarCaixinha()
        if isSampAvailable() then
            sampSendChat("/caixinha")
            sampAddChatMessage('[ShoxFarm] Auto Caixinha: /caixinha enviado!', 0x00CFFF)
        end
    end

    local function caixinhaLigar()
        if cxAtivo then return end
        cxAtivo = true
        chkCaixinha.v = true
        enviarCaixinha()
        lua_thread.create(function()
            while cxAtivo do
                wait(CAIXINHA_MS)
                if cxAtivo and isSampAvailable() then enviarCaixinha() end
            end
        end)
        sampAddChatMessage('[ShoxFarm] Auto Caixinha ATIVADO', 0x00FF88)
    end

    local function caixinhaDesligar()
        if not cxAtivo then return end
        cxAtivo = false
        chkCaixinha.v = false
        sampAddChatMessage('[ShoxFarm] Auto Caixinha DESATIVADO', 0xFF6666)
    end

    -- ===================================================================
    --  AUTO DROGAS
    -- ===================================================================
    -- drogas disponíveis
    local DROGAS = {
        { label = "|   |AutoLsd",      cmd = "/usarlsd"      },
        { label = "|   |AutoCrack",    cmd = "/usarcrack"    },
        { label = "|   |AutoCocaina",  cmd = "/usarcocaina"  },
        { label = "|   |AutoMaconha",  cmd = "/usarmaconha"  },
    }

    -- checkboxes ImBool para cada droga
    local chkDrogas = {}
    for i = 1, #DROGAS do
        chkDrogas[i] = imgui.ImBool(false)
    end

    -- estado de ativação por droga
    local drogaAtiva  = { false, false, false, false }
    -- índice da droga rodando no loop (só 1 por vez, mas checkboxes independentes)
    -- Na verdade permitimos múltiplas ativas simultaneamente (threads separadas)

    local ARMOUR_ALVO  = 200
    local DROGA_DELAY  = 1500   -- ms entre tentativas

    local function getArmour()
        -- getCharArmour retorna float 0-100 no SAMP standard
        -- mas alguns servidores usam 0-100 → vamos pegar raw e comparar com 100
        -- Ajuste se seu servidor usa escala diferente
        local ok, armour = pcall(getCharArmour, playerPed)
        if ok then return armour else return 0 end
    end

    local function usarDroga(idx)
        local droga = DROGAS[idx]
        if not droga then return end

        -- Ativa proteções
        rpcLigar()

        -- Envia o comando
        sampSendChat(droga.cmd)
        sampAddChatMessage('[ShoxFarm] ' .. droga.label:gsub('|   |', '') .. ': ' .. droga.cmd .. ' enviado!', 0xFFAA00)

        -- Desativa proteções após 600ms (tempo suficiente pra animação não prender)
        lua_thread.create(function()
            wait(600)
            rpcDesligar()
        end)
    end

    local function iniciarDroga(idx)
        if drogaAtiva[idx] then return end
        drogaAtiva[idx]  = true
        chkDrogas[idx].v = true

        local droga = DROGAS[idx]
        sampAddChatMessage('[ShoxFarm] ' .. droga.label:gsub('|   |', '') .. ' ATIVADO', 0x00FF88)

        lua_thread.create(function()
            while drogaAtiva[idx] do
                local armour = getArmour()
                if armour < ARMOUR_ALVO then
                    usarDroga(idx)
                end
                wait(DROGA_DELAY)
            end
        end)
    end

    local function pararDroga(idx)
        if not drogaAtiva[idx] then return end
        drogaAtiva[idx]  = false
        chkDrogas[idx].v = false
        local droga = DROGAS[idx]
        sampAddChatMessage('[ShoxFarm] ' .. droga.label:gsub('|   |', '') .. ' DESATIVADO', 0xFF6666)
    end

    -- ===================================================================
    --  EVENTO: onServerMessage (caixinha + juros)
    -- ===================================================================
    local function onServerMessage(color, text)
        -- Gatilho Juros Bancario → caixinha
        if cxAtivo then
            local limpo = text:gsub('{%x%x%x%x%x%x}', '')
            if limpo:lower():find('juros bancario') then
                lua_thread.create(function()
                    wait(300)
                    enviarCaixinha()
                end)
            end
        end
    end

    -- ===================================================================
    --  GUI
    -- ===================================================================
    local function pushChkStyle()
        imgui.PushStyleColor(imgui.Col.CheckMark,      imgui.ImVec4(0.85, 0.10, 0.10, 1.00))
        imgui.PushStyleColor(imgui.Col.FrameBg,        imgui.ImVec4(0.15, 0.10, 0.10, 1.00))
        imgui.PushStyleColor(imgui.Col.FrameBgHovered, imgui.ImVec4(0.25, 0.08, 0.08, 1.00))
        imgui.PushStyleColor(imgui.Col.FrameBgActive,  imgui.ImVec4(0.40, 0.06, 0.06, 1.00))
    end

    local function popChkStyle()
        imgui.PopStyleColor(4)
    end

    local function drawGui(W)
        imgui.Dummy(imgui.ImVec2(0, 6))

        -- ── Título ───────────────────────────────────────────────
        local titulo = "  Auto's"
        local tw = imgui.CalcTextSize(titulo).x
        imgui.SetCursorPosX((W - tw) * 0.5)
        imgui.PushStyleColor(imgui.Col.Text, imgui.ImVec4(0.00, 0.80, 1.00, 1.00))
        imgui.Text(titulo)
        imgui.PopStyleColor()

        imgui.SetCursorPosX(20)
        imgui.Text("------------------------------------------------")
        imgui.Dummy(imgui.ImVec2(0, 4))

        -- ── Seção: Auto Caixinha ──────────────────────────────────
        imgui.SetCursorPosX(20)
        imgui.PushStyleColor(imgui.Col.Text, imgui.ImVec4(0.80, 0.80, 0.20, 1.00))
        imgui.Text("[ Caixinha ]")
        imgui.PopStyleColor()
        imgui.Dummy(imgui.ImVec2(0, 3))

        pushChkStyle()
        imgui.SetCursorPosX(20)
        if imgui.Checkbox("|   |Auto caixinha", chkCaixinha) then
            if chkCaixinha.v then caixinhaLigar() else caixinhaDesligar() end
        end
        popChkStyle()

        -- status caixinha
        imgui.SameLine()
        imgui.SetCursorPosX(W - 80)
        if cxAtivo then
            imgui.PushStyleColor(imgui.Col.Text, imgui.ImVec4(0.00, 1.00, 0.55, 1.00))
            imgui.Text("[ON]")
        else
            imgui.PushStyleColor(imgui.Col.Text, imgui.ImVec4(0.55, 0.55, 0.55, 1.00))
            imgui.Text("[OFF]")
        end
        imgui.PopStyleColor()

        imgui.Dummy(imgui.ImVec2(0, 4))
        imgui.SetCursorPosX(20)
        imgui.PushStyleColor(imgui.Col.Text, imgui.ImVec4(0.55, 0.55, 0.55, 1.00))
        imgui.Text("Timer: 30min  |  Gatilho: Juros Bancario")
        imgui.PopStyleColor()

        imgui.Dummy(imgui.ImVec2(0, 8))
        imgui.SetCursorPosX(20)
        imgui.Text("------------------------------------------------")
        imgui.Dummy(imgui.ImVec2(0, 4))

        -- ── Seção: Auto Drogas ────────────────────────────────────
        imgui.SetCursorPosX(20)
        imgui.PushStyleColor(imgui.Col.Text, imgui.ImVec4(0.80, 0.80, 0.20, 1.00))
        imgui.Text("[ Drogas — para quando colete = 200 ]")
        imgui.PopStyleColor()
        imgui.Dummy(imgui.ImVec2(0, 5))

        for i, droga in ipairs(DROGAS) do
            pushChkStyle()
            imgui.SetCursorPosX(20)
            if imgui.Checkbox(droga.label .. "##drg" .. i, chkDrogas[i]) then
                if chkDrogas[i].v then
                    iniciarDroga(i)
                else
                    pararDroga(i)
                end
            end
            popChkStyle()

            -- status inline
            imgui.SameLine()
            imgui.SetCursorPosX(W - 80)
            if drogaAtiva[i] then
                imgui.PushStyleColor(imgui.Col.Text, imgui.ImVec4(0.00, 1.00, 0.55, 1.00))
                imgui.Text("[ON]")
            else
                imgui.PushStyleColor(imgui.Col.Text, imgui.ImVec4(0.55, 0.55, 0.55, 1.00))
                imgui.Text("[OFF]")
            end
            imgui.PopStyleColor()

            imgui.Dummy(imgui.ImVec2(0, 2))
        end

        imgui.Dummy(imgui.ImVec2(0, 6))
        imgui.SetCursorPosX(20)
        imgui.PushStyleColor(imgui.Col.Text, imgui.ImVec4(0.50, 0.50, 0.50, 1.00))
        imgui.TextWrapped("Proteção RPC ativa durante cada uso: freeze, anim, embriaguez, sinc. de armas.")
        imgui.PopStyleColor()

        -- colete atual
        imgui.Dummy(imgui.ImVec2(0, 4))
        imgui.SetCursorPosX(20)
        local armourAtual = getArmour()
        local corA = (armourAtual >= ARMOUR_ALVO)
            and imgui.ImVec4(0.00, 1.00, 0.55, 1.00)
            or  imgui.ImVec4(1.00, 0.55, 0.00, 1.00)
        imgui.PushStyleColor(imgui.Col.Text, corA)
        imgui.Text(string.format("Colete atual: %.0f / %d", armourAtual, ARMOUR_ALVO))
        imgui.PopStyleColor()
    end

    -- ===================================================================
    --  INTERFACE PÚBLICA
    -- ===================================================================
    return {
        drawGui         = drawGui,
        onServerMessage = onServerMessage,
        isAtivo         = function() return cxAtivo or drogaAtiva[1] or drogaAtiva[2] or drogaAtiva[3] or drogaAtiva[4] end,
    }
end
